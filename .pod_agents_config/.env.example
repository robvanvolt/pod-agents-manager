POD_OPENAI_BASE_URL="<your-openai-base-url-with-trailing-/v1>"
POD_OPENAI_API_KEY="<your-api-key>"
POD_DEFAULT_MODEL="<your-default-model>"
# Context window in tokens to declare to agents that need it (e.g. codex's
# model_context_window). Defaults to 131072 (128k) — bump for larger-context
# models, e.g. 262144 for 256k.
POD_DEFAULT_MODEL_CONTEXT_SIZE="131072"
POD_IMAGE_CACHE_ROOT="$HOME/.cache/podman-containers"
POD_BASE_IMAGE="alpine"