POD_OPENAI_BASE_URL="<your-openai-base-url-with-trailing-/v1>"
POD_OPENAI_API_KEY="<your-api-key>"
POD_DEFAULT_MODEL="<your-default-model>"
# Context window in tokens to declare to agents that need it (e.g. codex's
# model_context_window). Defaults to 131072 (128k) — bump for larger-context
# models, e.g. 262144 for 256k.
POD_DEFAULT_MODEL_CONTEXT_SIZE="131072"
POD_IMAGE_CACHE_ROOT="$HOME/.cache/podman-containers"
POD_BASE_IMAGE="alpine"

# Dashboard unlock key. `pod server start` generates it when left empty.
POD_SERVER_API_KEY=""

# Optional — populate to enable the web skill via a Cloakbrowser/CDP service.
POD_WEB_BROWSER=""

# Optional — populate to enable the forgejo-workflow skill.
# Generate POD_FORGEJO_TOKEN at <forgejo>/user/settings/applications with
# "repo" scope. The token is used for both API repo-creation and HTTPS push.
POD_FORGEJO_URL=""
POD_FORGEJO_USER=""
POD_FORGEJO_EMAIL=""
POD_FORGEJO_TOKEN=""

# Optional — judge LLM for `pod bench`. Each value falls back to the main
# POD_OPENAI_* / POD_DEFAULT_MODEL above, so leaving these empty judges with
# the same local model that did the work. Point at a stronger model for more
# discriminating scores.
POD_BENCH_JUDGE_MODEL=""
POD_BENCH_JUDGE_BASE_URL=""
POD_BENCH_JUDGE_API_KEY=""
